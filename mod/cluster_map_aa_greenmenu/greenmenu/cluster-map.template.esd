###########################################################################################
#
# Custom Green Engineering Menu screen: phone map on the digital cluster
# Attached to the top level of the green engineering menu, so it does not
# depend on any other screen being installed.
# Main -> ClusterMap
#
# The entries run scripts straight from the SD card in slot 1:
#   @GREENMENU@
#
# Screen design v2 (2026-11-06): EVERY entry routes through ONE script
# (menus.sh). A partial card copy can then produce one "Script not found"
# message at worst, never a tree of missing switches; custom.sh's install
# self-check names the missing files exactly.

###########################################################################################
screen ClusterMap Main

keyValue
    value   String sys 0x00000000 0
    label   "Phone map on the digital cluster"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "SD card must be in slot 1. Reboot after install."
    poll    0

script
    value   sys 1 0x0100 "@GREENMENU@gem/status.sh"
    label   "1. Status and compatibility check"

script
    value   sys 1 0x0100 "@GREENMENU@gem/install.sh"
    label   "2. Install cluster map"

script
    value   sys 1 0x0100 "@GREENMENU@gem/arm.sh"
    label   "2b. Make the map LIVE (arm; reboot after)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/full_frame_on.sh"
    label   "Sharper map ON (full frame; reboot after)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/full_frame_off.sh"
    label   "Sharper map OFF (standard; reboot after)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/keep_map_on.sh"
    label   "Keep map ON (arbiter; fork)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/keep_map_off.sh"
    label   "Keep map OFF (standard; fork)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/verify.sh"
    label   "Verify installed files (fork)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/zoom_off.sh"
    label   "Zoom 1.0 (off; standard map view)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/zoom_115.sh"
    label   "Zoom 1.15 (crop-and-enlarge; live)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/zoom_135.sh"
    label   "Zoom 1.35 (crop-and-enlarge; live)"

script
script
    value   sys 1 0x0100 "@GREENMENU@gem/position_higher.sh"
    label   "Position: content UP a step (next phone session)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/position_lower.sh"
    label   "Position: content DOWN a step (next phone session)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/position_wider.sh"
    label   "Position: content WIDER (less side margin)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/position_narrower.sh"
    label   "Position: content NARROWER (more side margin)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/position_standard.sh"
    label   "Position: back to the shipped look"

    value   sys 1 0x0100 "@GREENMENU@gem/cardclear_top.sh"
    label   "Turn-card clear: TOP strip"

script
    value   sys 1 0x0100 "@GREENMENU@gem/cardclear_sides.sh"
    label   "Turn-card clear: SIDES free"

script
    value   sys 1 0x0100 "@GREENMENU@gem/cardclear_band.sh"
    label   "Turn-card clear: middle BAND"

script
    value   sys 1 0x0100 "@GREENMENU@gem/cardclear_off.sh"
    label   "Turn-card clear: OFF (standard layout)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/navstrip_on.sh"
    label   "Turn info strip: ON (road | ETA | distance)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/navstrip_off.sh"
    label   "Turn info strip: OFF"

script
    value   sys 1 0x0100 "@GREENMENU@gem/remote_on.sh"
    label   "Cluster remote: ON (short OK = presets, long OK = strip)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/remote_off.sh"
    label   "Cluster remote: OFF"

script
    value   sys 1 0x0100 "@GREENMENU@gem/uninstall.sh"
    label   "Uninstall and restore original state"

script
    value   sys 1 0x0100 "@GREENMENU@gem/tbt.sh"
    label   "Switch to turn-by-turn arrows instead (no map)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/logs.sh"
    label   "Save logs to SD"

script
    value   sys 1 0x0100 "@GREENMENU@gem/porting.sh"
    label   "Collect files for porting (quick)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/portfull.sh"
    label   "Collect for porting, with Java image (55 MB, slow)"

script
    value   sys 1 0x0100 "/net/mmx/fs/sda0/esd/scripts/reboot.sh"
    label   "Reboot the unit (M.I.B.'s own reboot, 10 s countdown)\n"
