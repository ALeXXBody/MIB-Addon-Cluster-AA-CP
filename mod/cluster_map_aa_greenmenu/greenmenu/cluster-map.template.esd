    label   "Switch to arrows"

script
    value   sys 1 0x0100 "@GREENMENU@gem/porting.sh"
    label   "Collect porting (quick)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/portfull.sh"
    label   "Collect porting (55MB)"

script
    value   sys 1 0x0100 "@GREENMENU@gem/virgin.sh"
    label   "Virgin unit (remove all)"

script
    value   sys 1 0x0100 "/net/mmx/fs/sda0/esd/scripts/reboot.sh"
    label   "Reboot the unit"

