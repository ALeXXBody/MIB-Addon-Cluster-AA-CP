    label   "Hi-res OFF"

script
    value   sys 1 0x0100 "@GREENMENU@gem/idrpump_on.sh"
    label   "Sharpness pump ON"

script
    value   sys 1 0x0100 "@GREENMENU@gem/idrpump_off.sh"
    label   "Sharpness pump OFF"

